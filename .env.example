# Railway OAuth app: workspace settings → Developer → OAuth Apps (type: Web).
# Register the redirect URI <APP_URL>/auth/callback, e.g. http://localhost:3000/auth/callback
RAILWAY_OAUTH_CLIENT_ID="rlwy_oaci_abc123"
RAILWAY_OAUTH_CLIENT_SECRET="rlwy_oacs_abc123"

# Encrypts the session cookie. At least 32 characters: `openssl rand -base64 32`
SESSION_SECRET="change-me"

# Public origin of the app. Defaults to http://localhost:3000.
# APP_URL="https://console.example.com"
