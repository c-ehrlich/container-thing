{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    // Only read by the gql.tada CLI (scripts/generate-graphql.sh); the editor plugin needs TS 5/6.
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "./src/graphql/railway-schema.graphql",
        "tadaOutputLocation": "./src/graphql/graphql-env.d.ts"
      }
    ]
  },
  "include": ["src", "vite.config.ts"]
}
